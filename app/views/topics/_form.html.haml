.card.border-0.shadow-sm
  .card-body
    = form_with model: @topic, data: { turbo: false }, html: { multipart: true } do |f|
      .mb-3
        = f.label :title, class: "form-label"
        = f.text_field :title, class: "form-control", placeholder: "Title"

      .mb-3
        = f.label :body, class: "form-label"
        = f.text_area :body, rows: 8, class: "form-control", placeholder: "Write your topic..."

      .mb-3
        = f.label :image, "Image (optional)", class: "form-label"
        = f.file_field :image, class: "form-control"
        - if @topic.image.attached?
          .mt-2
            = image_tag @topic.image.variant(resize_to_limit: [800, 800]), class: "img-fluid rounded"

      .d-flex.gap-2
        = f.submit ( @topic.persisted? ? "Update" : "Create" ), class: "btn btn-warning"
        = link_to "Cancel", (@topic.persisted? ? @topic : topics_path), class: "btn btn-outline-dark"
